# RAILWAY - Backend Spring Boot
# Root Directory del servicio: backend/sistema-ot
# Base de datos: Supabase (no agregar PostgreSQL de Railway si usas Supabase)

SPRING_PROFILES_ACTIVE=cloud

# Conexion recomendada a Supabase (Settings > Database > Connection string)
PG_URL=jdbc:postgresql://db.[REF].supabase.co:5432/postgres?sslmode=require
PGUSER=postgres.[REF]
PGPASSWORD=[PASSWORD]

JWT_SECRET=genera-clave-aleatoria-minimo-32-caracteres-aqui
CORS_ALLOWED_ORIGIN=https://tu-proyecto.vercel.app
SEED_DEMO_DATA=true
JPA_DDL_AUTO=validate
VALIDACION_FOTOS_URL=http://45.71.33.77/proyecto_lima/

# Alternativa compatible:
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Railway asigna PORT automaticamente - no definir manualmente
