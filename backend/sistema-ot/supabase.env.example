# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE — Base de datos PostgreSQL en la nube
# Crear proyecto en https://supabase.com → copiar valores al dashboard
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Crear proyecto Supabase (región cercana, ej. South America)
# 2. SQL Editor → ejecutar database/bootstrap.sql (o sistema_OT_BD_clean.sql)
# 3. Settings → Database → Connection string → URI (modo Session, puerto 5432)

# Pegar en Railway → Variables (servicio backend):

SPRING_PROFILES_ACTIVE=cloud

# Opción recomendada — URI completa de Supabase:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[TU-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Opción alternativa — JDBC + usuario/contraseña por separado:
# PG_URL=jdbc:postgresql://db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# PGUSER=postgres
# PGPASSWORD=[TU-PASSWORD]

JWT_SECRET=genera-clave-aleatoria-minimo-32-caracteres-aqui
CORS_ALLOWED_ORIGIN=https://tu-proyecto.vercel.app
SEED_DEMO_DATA=true
JPA_DDL_AUTO=validate
VALIDACION_FOTOS_URL=http://45.71.33.77/proyecto_lima/

# Después del primer deploy exitoso:
# SEED_DEMO_DATA=false
